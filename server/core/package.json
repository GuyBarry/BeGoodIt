{
  "name": "core",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "ts-node app.ts",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:start": "dotenv -e .env.development docker compose -f db/localdb/docker-compose.yml up -d",
    "db:stop": "docker compose -f db/localdb/docker-compose.yml down",
    "db:drop": "docker compose -f db/localdb/docker-compose.yml down -v",
    "db:logs": "docker compose -f db/localdb/docker-compose.yml logs -f mysql",
    "typeorm": "dotenv -e .env.development -- typeorm-ts-node-commonjs -d db/datasource.ts",
    "migration:generate": "npm run typeorm -- migration:generate --pretty",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "typeorm:prod": "dotenv -e .env.production -- typeorm-ts-node-commonjs -d db/datasource.ts",
    "migration:run:prod": "npm run typeorm:prod -- migration:run",
    "migration:revert:prod": "npm run typeorm:prod -- migration:revert",
    "migration:show:prod": "npm run typeorm:prod -- migration:show"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.22.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "dotenv-cli": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
